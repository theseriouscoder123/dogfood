// DOGFOOD portal data model.
// Invariants Prisma cannot express (partial unique indexes, CHECKs, triggers) live in the
// init migration's hand-written SQL block; see prisma/migrations/*_init/migration.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventRoleType {
  participant
  judge
  organizer
}

enum TeamRole {
  captain
  member
}

enum ProjectStatus {
  draft
  submitted
  withdrawn
  disqualified
}

enum AssignmentStatus {
  assigned
  in_progress
  submitted
  recused
}

enum ReviewStatus {
  draft
  submitted
}

enum CoiSource {
  declared
  detected
}

// How community voters prove who they are (T3). Strongest to weakest against fake voters:
// invite codes (organizer controls supply), verified email (one inbox, one ballot),
// accounts (anyone can register an account, so it relies on detection).
enum VotingMode {
  email
  invite
  accounts
}

enum CommentsMode {
  open // anyone signed in can comment
  read_only // existing comments stay visible, nobody can post (e.g. after the event)
  off // no comments shown or posted
}

enum ReportReason {
  spam
  abuse
  off_topic
  other
}

enum BallotStatus {
  counted
  quarantined
}

enum QuestionType {
  short_text
  long_text
  url
  single_select
  checkbox
}

// ── identity ────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique // always stored lower-cased
  name            String
  passwordHash    String? // null = cannot log in with a password (e.g. imported, not yet claimed)
  emailVerifiedAt DateTime? @db.Timestamptz(3) // set when the user proves they read this inbox (sign-in link, reset link)
  isAdmin         Boolean   @default(false) // the only global role; everything else is per event
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  sessions       Session[]
  eventRoles     EventRole[]
  judgeTracks    JudgeTrack[]
  memberships    TeamMember[]
  teamsCreated   Team[]                @relation("TeamCreatedBy")
  invitesCreated TeamInvite[]
  assignments    Assignment[]
  batchesCreated AssignmentBatch[]
  conflicts      ConflictOfInterest[]
  runsCreated    NormalizationRun[]
  auditEntries   AuditLog[]
  integrity      IntegrityResolution[]
  voters         Voter[]
  voteInvites    VoteInvite[]
  comments       Comment[]             @relation("CommentAuthor")
  commentsHidden Comment[]             @relation("CommentHiddenBy")
  commentReports CommentReport[]
  uploads        Upload[]
  passwordResets PasswordReset[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique // sha256 of the cookie value; the raw token is never stored
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  seeded    Boolean  @default(false) // demo sessions printed at boot; removed when SEED_DEMO=false
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── event setup ─────────────────────────────────────────────────────────────

model Event {
  id                  String       @id @default(uuid()) @db.Uuid
  slug                String       @unique
  externalId          String?      @unique // id in an imported file, e.g. "evt_01"
  name                String
  description         String       @default("") // short summary for cards
  tagline             String       @default("")
  location            String       @default("Online")
  overview            String       @default("") // markdown, shown on the event page
  rules               String       @default("") // markdown
  bannerUrl           String? // uploaded file (/api/files/...) or external URL
  logoUrl             String?
  timezone            String       @default("UTC") // display only; every timestamp is stored in UTC
  registrationOpensAt DateTime?    @db.Timestamptz(3)
  submissionsOpenAt   DateTime     @db.Timestamptz(3)
  submissionsCloseAt  DateTime     @db.Timestamptz(3)
  judgingOpensAt      DateTime?    @db.Timestamptz(3)
  judgingClosesAt     DateTime?    @db.Timestamptz(3)
  maxTeamSize         Int          @default(4)
  votingOpensAt       DateTime?    @db.Timestamptz(3) // null = no community vote
  votingClosesAt      DateTime?    @db.Timestamptz(3)
  votingMode          VotingMode   @default(email)
  votesPerVoter       Int          @default(3) // each voter picks up to this many projects
  voterDomains        String[]     @default([]) // allowed email domains; empty = anyone
  commentsMode        CommentsMode @default(open)
  votingPublishedAt   DateTime?    @db.Timestamptz(3) // People's Choice results made public
  votingBallotsHash   String? // SHA-256 of the published ballot file, fixed at publish time
  publishedRunId      String?      @unique @db.Uuid // null = results hidden
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(3)

  publishedRun NormalizationRun?     @relation("PublishedRun", fields: [publishedRunId], references: [id])
  roles        EventRole[]
  tracks       Track[]
  prizes       Prize[]
  teams        Team[]
  teamMembers  TeamMember[]
  projects     Project[]
  criteria     Criterion[]
  batches      AssignmentBatch[]
  assignments  Assignment[]
  reviews      Review[]
  judgeTracks  JudgeTrack[]
  conflicts    ConflictOfInterest[]
  runs         NormalizationRun[]    @relation("EventRuns")
  auditEntries AuditLog[]
  questions    SubmissionQuestion[]
  integrity    IntegrityResolution[]
  voters       Voter[]
  voteInvites  VoteInvite[]
  ballots      Ballot[]
  comments     Comment[]
}

model EventRole {
  eventId    String        @db.Uuid
  userId     String        @db.Uuid
  role       EventRoleType
  externalId String? // imported person id within the event, e.g. judge "jdg_24"
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId, role])
  @@unique([eventId, externalId])
  @@index([userId])
}

model Track {
  id          String  @id @default(uuid()) @db.Uuid
  eventId     String  @db.Uuid
  externalId  String?
  name        String
  description String  @default("")

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  prizes      Prize[]
  projects    Project[]
  judgeTracks JudgeTrack[]

  @@unique([eventId, name])
  @@unique([eventId, externalId])
  @@unique([id, eventId]) // target for composite FKs that pin a row to the same event
}

model Prize {
  id          String  @id @default(uuid()) @db.Uuid
  eventId     String  @db.Uuid
  trackId     String? @db.Uuid // null = overall prize
  name        String
  description String  @default("")
  value       String  @default("") // free text: "$500", "Mentorship", ...
  rank        Int?

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  track Track? @relation(fields: [trackId, eventId], references: [id, eventId], onDelete: Cascade)

  @@index([eventId])
}

// Which tracks a judge may see. Judges never see projects outside their tracks.
model JudgeTrack {
  eventId String @db.Uuid
  userId  String @db.Uuid
  trackId String @db.Uuid

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId, eventId], references: [id, eventId], onDelete: Cascade)

  @@id([eventId, userId, trackId])
}

// ── teams & submissions ─────────────────────────────────────────────────────

model Team {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @db.Uuid
  externalId  String?
  name        String
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  event     Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User?                @relation("TeamCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members   TeamMember[]
  invites   TeamInvite[]
  projects  Project[]
  conflicts ConflictOfInterest[]

  @@unique([eventId, externalId])
  @@unique([id, eventId])
  @@index([eventId, name]) // not unique: real events (and the fixtures) have different teams with the same name
}

model TeamMember {
  teamId   String   @db.Uuid
  userId   String   @db.Uuid
  eventId  String   @db.Uuid // denormalised so "one team per person per event" is a plain unique index
  role     TeamRole @default(member)
  joinedAt DateTime @default(now()) @db.Timestamptz(3)

  team  Team  @relation(fields: [teamId, eventId], references: [id, eventId], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@unique([eventId, userId]) // one team per person per event
}

model TeamInvite {
  id          String    @id @default(uuid()) @db.Uuid
  teamId      String    @db.Uuid
  tokenHash   String    @unique
  createdById String    @db.Uuid
  expiresAt   DateTime  @db.Timestamptz(3)
  maxUses     Int       @default(10)
  uses        Int       @default(0)
  revokedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model Project {
  id            String        @id @default(uuid()) @db.Uuid
  eventId       String        @db.Uuid
  teamId        String        @db.Uuid
  trackId       String?       @db.Uuid
  externalId    String?
  title         String
  tagline       String        @default("")
  description   String        @default("")
  repoUrl       String?
  demoUrl       String?
  videoUrl      String?
  thumbnailUrl  String?
  techTags      String[]      @default([])
  status        ProjectStatus @default(draft)
  submittedAt   DateTime?     @db.Timestamptz(3)
  duplicateOfId String?       @db.Uuid // flagged duplicate; excluded from gallery and ranking
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  event         Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team          Team            @relation(fields: [teamId, eventId], references: [id, eventId], onDelete: Cascade)
  track         Track?          @relation(fields: [trackId, eventId], references: [id, eventId])
  duplicateOf   Project?        @relation("Duplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    Project[]       @relation("Duplicates")
  assignments   Assignment[]
  reviews       Review[]
  results       ProjectResult[]
  answers       ProjectAnswer[]
  ballotChoices BallotChoice[]
  comments      Comment[]
  views         ProjectView[]

  @@unique([eventId, externalId])
  @@unique([id, eventId])
  @@index([eventId, status])
}

// ── judging ─────────────────────────────────────────────────────────────────

model Criterion {
  id          String  @id @default(uuid()) @db.Uuid
  eventId     String  @db.Uuid
  key         String // stable machine name, e.g. "functionality"
  label       String
  description String  @default("")
  weight      Decimal @default(1) @db.Decimal(6, 3) // relative; applied at compute time, not stored in scores
  minScore    Int     @default(1)
  maxScore    Int     @default(5)
  position    Int     @default(0)

  event  Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scores ReviewScore[]

  @@unique([eventId, key])
}

model AssignmentBatch {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @db.Uuid
  name        String
  algorithm   String // "import" | "manual" | "csv" | "balanced-greedy" ...
  params      Json     @default("{}")
  seed        Int? // RNG seed, so an algorithmic batch can be reproduced exactly
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  assignments Assignment[]
}

model Assignment {
  id            String           @id @default(uuid()) @db.Uuid
  eventId       String           @db.Uuid
  batchId       String?          @db.Uuid
  judgeId       String           @db.Uuid
  projectId     String           @db.Uuid
  status        AssignmentStatus @default(assigned)
  recusalReason String?
  openedAt      DateTime?        @db.Timestamptz(3) // first time the judge opened it; review speed is an integrity signal
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)

  event   Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  batch   AssignmentBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  judge   User             @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  project Project          @relation(fields: [projectId, eventId], references: [id, eventId], onDelete: Cascade)
  review  Review?

  @@unique([judgeId, projectId])
  @@unique([id, judgeId, projectId])
  @@index([eventId, status])
}

// A review always belongs to exactly one assignment, and its judge/project must match it.
model Review {
  id           String       @id @default(uuid()) @db.Uuid
  assignmentId String       @unique @db.Uuid
  eventId      String       @db.Uuid
  judgeId      String       @db.Uuid
  projectId    String       @db.Uuid
  comment      String       @default("")
  status       ReviewStatus @default(draft)
  submittedAt  DateTime?    @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  assignment Assignment    @relation(fields: [assignmentId, judgeId, projectId], references: [id, judgeId, projectId], onDelete: Cascade)
  event      Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scores     ReviewScore[]

  @@unique([assignmentId, judgeId, projectId]) // required by Prisma for the 1:1 composite relation
  @@index([eventId, judgeId])
  @@index([projectId])
}

// Raw per-criterion value. Range and same-event checks are enforced by a trigger.
model ReviewScore {
  reviewId    String @db.Uuid
  criterionId String @db.Uuid
  value       Int

  review    Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criterion Criterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@id([reviewId, criterionId])
}

model ConflictOfInterest {
  id        String    @id @default(uuid()) @db.Uuid
  eventId   String    @db.Uuid
  judgeId   String    @db.Uuid
  teamId    String    @db.Uuid
  source    CoiSource
  note      String    @default("")
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judge User  @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([eventId, judgeId, teamId])
}

// ── results: immutable snapshots, one per computation ───────────────────────

model NormalizationRun {
  id             String   @id @default(uuid()) @db.Uuid
  eventId        String   @db.Uuid
  method         String
  params         Json     @default("{}")
  weights        Json // criterion key -> weight, as used by this run
  inputHash      String // sha256 of the reviews that went in
  componentCount Int // connected components of the judge-project graph
  summary        Json     @default("{}") // μ, σ, iterations, rank agreement, exclusions (with reasons)
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  event        Event           @relation("EventRuns", fields: [eventId], references: [id], onDelete: Cascade)
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  publishedFor Event?          @relation("PublishedRun")
  results      ProjectResult[]
  judgeStats   JudgeStat[]
}

model ProjectResult {
  runId           String   @db.Uuid
  projectId       String   @db.Uuid
  nReviews        Int
  rawScore        Float? // null = no reviews
  normalizedScore Float?
  stdError        Float?
  rank            Int? // null = not ranked (duplicate, or no reviews)
  rawRank         Int?
  rankLow         Int? // 5th–95th percentile rank from the uncertainty simulation
  rankHigh        Int?
  pTop            Float? // chance of finishing in the top k (k = number of overall prizes, min 3)
  flags           String[] @default([])

  run     NormalizationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([runId, projectId])
}

model JudgeStat {
  runId    String   @db.Uuid
  judgeId  String   @db.Uuid
  nReviews Int
  rawMean  Float?
  offset   Float
  stdDev   Float?
  flags    String[] @default([])

  run NormalizationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([runId, judgeId])
}

// ── audit: append-only, hash-chained (see migration triggers) ───────────────

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  eventId     String?  @db.Uuid
  actorUserId String?  @db.Uuid
  actorLabel  String // "organizer@x.org", "system:seed", "anonymous"
  action      String // "project.submit", "submission.refused_closed", "rubric.weights_changed", ...
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  ip          String?
  requestId   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  prevHash    String
  hash        String   @unique

  // Restrict: history is never rewritten, so audited events/users are archived, not deleted.
  event Event? @relation(fields: [eventId], references: [id], onDelete: Restrict)
  actor User?  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([eventId, createdAt])
}

// ── organizer-defined submission questions ──────────────────────────────────

model SubmissionQuestion {
  id        String       @id @default(uuid()) @db.Uuid
  eventId   String       @db.Uuid
  label     String
  help      String       @default("")
  type      QuestionType
  options   String[]     @default([]) // for single_select
  required  Boolean      @default(false) // enforced when a project is submitted, not while drafting
  isPublic  Boolean      @default(true) // private answers are visible to the team and organizers only
  position  Int          @default(0)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  event   Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers ProjectAnswer[]

  @@index([eventId, position])
}

model ProjectAnswer {
  projectId  String   @db.Uuid
  questionId String   @db.Uuid
  value      String // checkbox answers are "true"/"false"
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  project  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  question SubmissionQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([projectId, questionId])
}

// ── files and account recovery ──────────────────────────────────────────────

// Images stored on local disk under their sha256; the row records who uploaded what.
model Upload {
  id           String   @id @default(uuid()) @db.Uuid
  sha256       String   @unique
  mimeType     String
  sizeBytes    Int
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([uploadedById, createdAt])
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// An organizer's decision about one integrity flag. Flags are recomputed from the data every
// time; the flag key is stable, so a decision stays attached to "the same" flag. History of
// every decision (including reopening) lives in the audit log.
model IntegrityResolution {
  eventId      String   @db.Uuid
  flagKey      String
  status       String // "dismissed" (looked, it's fine) | "confirmed" (a real problem, acted on)
  note         String   @default("")
  resolvedById String?  @db.Uuid
  resolvedAt   DateTime @default(now()) @db.Timestamptz(3)

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@id([eventId, flagKey])
}

// ── community voting (T3) ───────────────────────────────────────────────────

// A one-time sign-in link sent by email. Using it proves the inbox, logs the person in (creating
// a password-less account if needed) and marks the email verified. Used for voting and login.
model LoginLink {
  id        String    @id @default(uuid()) @db.Uuid
  email     String // lower-cased
  tokenHash String    @unique
  next      String    @default("/") // where to go after signing in (a path on this site)
  ip        String?
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// Single-use ballot codes an organizer hands out (e.g. printed QR codes at a venue).
// Only the hash is stored; the codes are shown once, when generated.
model VoteInvite {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @db.Uuid
  codeHash    String    @unique
  label       String    @default("") // which batch: "Venue badges", "Sponsor booth"
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)

  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  voter     Voter?

  @@index([eventId])
}

// One voting identity per person per event. identityKey is what makes a voter unique
// ("user:<id>" or "invite:<id>"); emailKey is the normalized inbox, so john+1@x and j.o.h.n@x
// (on providers that ignore dots) can't hold two ballots.
model Voter {
  id          String     @id @default(uuid()) @db.Uuid
  eventId     String     @db.Uuid
  kind        VotingMode
  userId      String?    @db.Uuid
  inviteId    String?    @unique @db.Uuid
  identityKey String
  emailKey    String?
  tokenHash   String?    @unique // invite voters have no account; their browser holds this token
  ip          String?
  userAgent   String?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)

  event  Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user   User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  invite VoteInvite? @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  ballot Ballot?

  @@unique([eventId, identityKey])
  @@unique([eventId, emailKey])
}

// A voter's picks. Editable until voting closes. Never readable by anyone but its voter while
// voting is open; afterwards it is published anonymously under its receipt's hash.
model Ballot {
  id               String       @id @default(uuid()) @db.Uuid
  eventId          String       @db.Uuid
  voterId          String       @unique @db.Uuid
  receipt          String       @unique // shown to the voter; lets them find their ballot in the published file
  status           BallotStatus @default(counted)
  quarantineReason String?
  ip               String?
  userAgent        String?
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  event   Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  voter   Voter          @relation(fields: [voterId], references: [id], onDelete: Cascade)
  choices BallotChoice[]

  @@index([eventId, status])
}

// position = where the project appeared on this voter's shuffled ballot (0 = first), kept so
// the published data can show that list position didn't decide the result.
model BallotChoice {
  ballotId  String   @db.Uuid
  projectId String   @db.Uuid
  position  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  ballot  Ballot  @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([ballotId, projectId])
  @@index([projectId])
}

// First time each voter opened each project page while voting was open. Lets the anti-abuse
// review spot "blind" votes: a surge of votes for a project its voters never looked at is what
// a "just click this link and vote for us" campaign looks like.
model ProjectView {
  eventId       String   @db.Uuid
  projectId     String   @db.Uuid
  viewerKey     String // the voter's identityKey: "user:<id>" or "invite:<id>"
  firstViewedAt DateTime @default(now()) @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, viewerKey])
  @@index([eventId, viewerKey])
}

// ── project comments (T3) ───────────────────────────────────────────────────

// Plain text only (links are made clickable when shown), one level of replies. Authors can edit
// for 15 minutes and delete any time; a deleted comment keeps its row (and its text, for
// moderation) but is never served again. Organizers hide instead of delete, with a reason.
model Comment {
  id           String    @id @default(uuid()) @db.Uuid
  eventId      String    @db.Uuid
  projectId    String    @db.Uuid
  authorId     String    @db.Uuid
  parentId     String?   @db.Uuid // a reply; replies to replies are refused (trigger)
  body         String
  ip           String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  editedAt     DateTime? @db.Timestamptz(3)
  deletedAt    DateTime? @db.Timestamptz(3)
  hiddenAt     DateTime? @db.Timestamptz(3)
  hiddenById   String?   @db.Uuid // null with hiddenAt set = hidden automatically after reports
  hiddenReason String?

  event    Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author   User            @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  hiddenBy User?           @relation("CommentHiddenBy", fields: [hiddenById], references: [id], onDelete: SetNull)
  parent   Comment?        @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[]       @relation("Replies")
  reports  CommentReport[]

  @@index([projectId, createdAt])
  @@index([eventId, createdAt])
  @@index([authorId, createdAt])
}

model CommentReport {
  id         String       @id @default(uuid()) @db.Uuid
  commentId  String       @db.Uuid
  reporterId String       @db.Uuid
  reason     ReportReason
  note       String       @default("")
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  resolvedAt DateTime?    @db.Timestamptz(3) // an organizer looked at it (hid the comment or dismissed the report)

  comment  Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter User    @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([commentId, reporterId]) // one report per person per comment
}
