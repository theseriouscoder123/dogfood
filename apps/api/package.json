{
  "name": "@dogfood/api",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx src/seed/run.ts",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx src/seed/run.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "audit:verify": "tsx src/scripts/verify-audit.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "vitest run && vitest run --config vitest.integration.config.ts",
    "judging:proof": "tsx src/scripts/judging-proof.ts",
    "openapi": "tsx src/scripts/openapi.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "nodemailer": "10.0.10",
    "prisma": "6.19.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
